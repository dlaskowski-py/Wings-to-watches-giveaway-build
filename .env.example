# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Both of these values are safe to ship in the browser bundle — the publishable
# key only grants what Row Level Security allows. The Supabase SECRET / service_role
# key must NEVER appear here or anywhere else in this repo; it lives only in
# Supabase Edge Function environment variables.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
